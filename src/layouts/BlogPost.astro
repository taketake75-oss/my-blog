---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

// サイドバー用に全記事を取得して最新順に並べ替え
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 2em 1em;
				display: grid;
				grid-template-columns: 1fr;
				gap: 2rem;
			}
			/* PC表示時に2カラム（本文 + サイドバー）化 */
			@media (min-width: 900px) {
				.container {
					grid-template-columns: 1fr 300px;
				}
			}
			.main-content {
				min-width: 0;
			}
			.title-section {
				margin-bottom: 2em;
				padding-bottom: 1em;
				border-bottom: 1px solid #e2e8f0;
				text-align: center;
			}
			.title-section h1 {
				font-size: 1.8rem;
				line-height: 1.4;
				margin: 0.5em 0;
			}
			.date {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.hero-image img {
				width: 100%;
				border-radius: 8px;
				margin-bottom: 1.5em;
			}
			/* サイドバーのスタイル */
			.sidebar {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			.widget {
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 12px;
				padding: 1.25rem;
			}
			.widget-title {
				font-size: 1.1rem;
				font-weight: bold;
				margin-top: 0;
				margin-bottom: 1rem;
				padding-bottom: 0.5rem;
				border-bottom: 2px solid rgb(var(--accent));
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-list li {
				margin-bottom: 0.8rem;
				padding-bottom: 0.8rem;
				border-bottom: 1px dashed #cbd5e1;
			}
			.post-list li:last-child {
				margin-bottom: 0;
				padding-bottom: 0;
				border-bottom: none;
			}
			.post-list a {
				text-decoration: none;
				color: rgb(var(--black));
				font-size: 0.9rem;
				line-height: 1.4;
				display: block;
			}
			.post-list a:hover {
				color: rgb(var(--accent));
			}
			.post-date {
				font-size: 0.75rem;
				color: rgb(var(--gray));
				display: block;
				margin-top: 0.2rem;
			}
		</style>
	</head>

	<body>
		<Header />
		<div class="container">
			<!-- 左側：記事本文エリア -->
			<main class="main-content">
				<article>
					<div class="title-section">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										更新日: <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>
					{heroImage && <div class="hero-image"><img src={heroImage} alt="" /></div>}
					<div class="prose">
						<slot />
					</div>
				</article>
			</main>

			<!-- 右側：サイドバーエリア -->
			<aside class="sidebar">
				<div class="widget">
					<h3 class="widget-title">最新・おすすめ記事</h3>
					<ul class="post-list">
						{
							allPosts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										{post.data.title}
										<span class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</aside>
		</div>
		<Footer />
	</body>
</html>